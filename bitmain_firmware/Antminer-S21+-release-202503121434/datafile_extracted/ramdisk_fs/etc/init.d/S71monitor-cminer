#!/bin/sh
#set -x
function do_start()
{
        check_inter="20s"
        while true; do
        sleep $check_inter
        #date
        a="$(ps | grep cminer | grep -v 'grep cminer')"
        if [ -z "$a" ] ; then
            /etc/init.d/S70cminer restart
        fi
        done
}

function do_stop()
{
        exit 0
}

case "$1" in
    start|"")
                do_start &
        ;;
    stop)
                do_stop
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac